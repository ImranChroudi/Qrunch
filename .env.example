# ---------------------------------------------------------------------------
# MenuQr environment variables
#
# 1. Copy this file to `.env.local`
# 2. Fill in the values from your Supabase project:
#    Project Settings -> API
#      - Project URL            -> NEXT_PUBLIC_SUPABASE_URL
#      - Publishable key        -> NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
#      - Secret key (service)   -> SUPABASE_SERVICE_ROLE_KEY   (scripts only)
#      - anon key               -> NEXT_PUBLIC_SUPABASE_ANON_KEY
# 3. Apply the schema:
#      npx supabase link --project-ref <ref>
#      npx supabase db push
#    ...or paste supabase/migrations/*.sql into the SQL editor in order.
# 4. Seed a demo restaurant + owner account:
#      npm run db:seed
# ---------------------------------------------------------------------------

# Public: safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER prefix with NEXT_PUBLIC_ and never commit it.
# Used exclusively by scripts/ to provision buckets, restaurants and owners.
SUPABASE_SERVICE_ROLE_KEY=

# Absolute origin of the deployment, used to build the public menu URL that is
# encoded into the QR code. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin account created by `npm run db:seed`.
SEED_ADMIN_EMAIL=owner@pizza-house.ma
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_RESTAURANT_NAME=Pizza House Tanger
